# Personal AI System Environment Configuration

# Inference Engine Configuration
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ORIGINS=""

# Local Cache & Storage Paths
LOCAL_CACHE_DIR=~/.cache/local-ai
GDRIVE_REMOTE_NAME=gdrive:ai-node

# Vector Store / RAG Configuration
CHROMA_PERSIST_DIR=~/.cache/local-ai/chroma
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# P2P Mesh Network & Cross-Device Control
MESH_HOST=127.0.0.1
MESH_PORT=8765
MOBILE_DEVICE_IP=100.64.0.2
MOBILE_ADB_PORT=5555

# Security Locks
REQUIRE_CONFIRMATION_FOR_DESTRUCTION=true
