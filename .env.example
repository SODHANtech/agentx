# ==============================================================================
# Smart Campus AI - Environment Configurations Template
# Copy this file to '.env' and fill in your local values. Do NOT commit '.env'.
# ==============================================================================

# Launcher / Bootstrapper Authentication Configuration
FLASK_SECRET_KEY=your_flask_session_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
LAUNCHER_PORT=5000
FRONTEND_URL=http://localhost:5173

# FastAPI Backend Configuration
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Vite Frontend Configuration (Required during frontend build/dev)
VITE_API_URL=http://127.0.0.1:8000
